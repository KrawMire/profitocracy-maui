<?xml version="1.0" encoding="utf-8"?>

<abstractions:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                              xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
                              xmlns:resx="clr-namespace:Profitocracy.Mobile.Resources.Strings"
                              xmlns:abstractions="clr-namespace:Profitocracy.Mobile.Abstractions"
                              xmlns:viewmodel="clr-namespace:Profitocracy.Mobile.ViewModels.Transactions"
                              xmlns:categories="clr-namespace:Profitocracy.Mobile.Models.Categories"
                              xmlns:controls="clr-namespace:Profitocracy.Mobile.Views.Shared.Controls"
                              x:Class="Profitocracy.Mobile.Views.Transactions.Pages.EditTransactionPage"
                              x:DataType="viewmodel:EditTransactionPageViewModel"
                              Loaded="EditTransactionPage_OnLoaded"
                              Shell.PresentationMode="ModalAnimated"
                              ios:Page.ModalPresentationStyle="PageSheet"
                              HideSoftInputOnTapped="True">
    <abstractions:BaseContentPage.Resources>
        <!-- Spending type card: dot, name and the word of the split -->
        <Style TargetType="Border" x:Key="TypeCard">
            <Setter Property="MinimumHeightRequest" Value="56"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"/>
        </Style>
        <!-- Field tile: note, date, time and repeat -->
        <Style TargetType="Border" x:Key="FieldTile">
            <Setter Property="HeightRequest" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"/>
        </Style>
        <!-- Keypad key -->
        <Style TargetType="Border" x:Key="Key">
            <Setter Property="HeightRequest" Value="48"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"/>
        </Style>
        <Style TargetType="Border" x:Key="FlatKey" BasedOn="{StaticResource Key}">
            <Setter Property="BackgroundColor" Value="Transparent"/>
        </Style>
        <Style TargetType="Label" x:Key="KeyText">
            <Setter Property="FontFamily" Value="SansSemiBold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="VerticalTextAlignment" Value="Center"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"/>
        </Style>
    </abstractions:BaseContentPage.Resources>

    <Grid RowDefinitions="auto,*,auto"
          Padding="0,8,0,0">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="44,*,44"
              Padding="8,0">
            <Grid Grid.Column="0"
                  HeightRequest="44">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CloseButton_OnClicked"/>
                </Grid.GestureRecognizers>
                <controls:IconView Data="{x:Static controls:Icons.Close}"
                                   Size="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Color="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"/>
            </Grid>
            <Label Grid.Column="1"
                   Style="{StaticResource TextBodyStrong}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   Text="{Binding Title}"/>
        </Grid>

        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,8,16,0"
                                 Spacing="12">

                <!-- Expense / Income -->
                <Border Style="{StaticResource Card}"
                        Padding="4">
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="4">
                        <controls:ChipView Grid.Column="0"
                                           Text="{x:Static resx:AppResources.AddTransaction_Expense}"
                                           IsSelected="{Binding IsExpense}"
                                           Tapped="ExpenseButton_OnClicked"/>
                        <controls:ChipView Grid.Column="1"
                                           Text="{x:Static resx:AppResources.AddTransaction_Income}"
                                           IsSelected="{Binding IsIncome}"
                                           Tapped="IncomeButton_OnClicked"/>
                    </Grid>
                </Border>

                <!-- The note: the amount -->
                <Border Style="{StaticResource NoteCard}"
                        Padding="0">
                    <Grid>
                        <controls:NotePatternView RosetteRings="0"/>
                        <VerticalStackLayout Padding="20,12,20,20">
                            <Grid ColumnDefinitions="auto,*">
                                <HorizontalStackLayout Grid.Column="0"
                                                       Spacing="6"
                                                       Padding="8,0"
                                                       Margin="-8,0,0,0"
                                                       MinimumHeightRequest="44">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="CurrencyButton_OnTapped"/>
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <Label Style="{StaticResource NoteSerialText}"
                                           VerticalTextAlignment="Center"
                                           Text="{Binding CurrencyText}"/>
                                    <controls:IconView Data="{x:Static controls:Icons.ChevronDown}"
                                                       Size="14"
                                                       VerticalOptions="Center"
                                                       Color="{StaticResource SageText}"/>
                                </HorizontalStackLayout>
                                <Label Grid.Column="1"
                                       Style="{StaticResource NoteSerialText}"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center"
                                       Text="{Binding RateText}"/>
                            </Grid>
                            <Label Style="{StaticResource NoteHeroAmount}"
                                   Margin="0,4,0,0"
                                   Text="{Binding HeroAmount}"/>
                            <Label Style="{StaticResource NoteLabel}"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding IsMultiCurrency}"
                                   Text="{Binding ConvertedText}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ConvertedAmount_OnTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Expense: 50 / 30 / 20 spending type -->
                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="8"
                      IsVisible="{Binding IsExpense}">
                    <Border Grid.Column="0"
                            Style="{StaticResource TypeCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MainTypeButton_OnClicked"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsMain}"
                                         Value="True">
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MainColor}, Dark={StaticResource DarkMainColor}}"/>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MainTint}, Dark={StaticResource DarkMainTint}}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="2"
                                             VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse Style="{StaticResource SpendingDot}"
                                         Fill="{AppThemeBinding Light={StaticResource MainColor}, Dark={StaticResource DarkMainColor}}"/>
                                <Label Style="{StaticResource TextBodyStrong}"
                                       Text="{x:Static resx:AppResources.AddTransaction_Main}"/>
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource TextCaption}"
                                   Margin="14,0,0,0"
                                   Text="{x:Static resx:AppResources.Common_NeedsWord}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1"
                            Style="{StaticResource TypeCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SecondaryTypeButton_OnClicked"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsSecondary}"
                                         Value="True">
                                <Setter Property="Stroke" Value="{StaticResource SecondaryColor}"/>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaryTint}, Dark={StaticResource DarkSecondaryTint}}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="2"
                                             VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse Style="{StaticResource SpendingDot}"
                                         Fill="{StaticResource SecondaryColor}"/>
                                <Label Style="{StaticResource TextBodyStrong}"
                                       Text="{x:Static resx:AppResources.AddTransaction_Secondary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSecondary}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource DarkSecondaryTextColor}}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource TextCaption}"
                                   Margin="14,0,0,0"
                                   Text="{x:Static resx:AppResources.Common_WantsWord}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2"
                            Style="{StaticResource TypeCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SavedTypeButton_OnClicked"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsSaved}"
                                         Value="True">
                                <Setter Property="Stroke" Value="{StaticResource SavedColor}"/>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SavedTint}, Dark={StaticResource DarkSavedTint}}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="2"
                                             VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse Style="{StaticResource SpendingDot}"
                                         Fill="{StaticResource SavedColor}"/>
                                <Label Style="{StaticResource TextBodyStrong}"
                                       Text="{x:Static resx:AppResources.AddTransaction_Saved}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSaved}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SavedText}, Dark={StaticResource DarkSavedText}}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource TextCaption}"
                                   Margin="14,0,0,0"
                                   Text="{x:Static resx:AppResources.Common_SavingsWord}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Expense: category -->
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            Margin="0,0,-16,0"
                            IsVisible="{Binding IsExpense}">
                    <HorizontalStackLayout Spacing="8"
                                           Padding="0,0,16,0"
                                           BindableLayout.ItemsSource="{Binding CategoryChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="categories:CategoryChipModel">
                                <controls:ChipView Text="{Binding Name}"
                                                   IsSelected="{Binding IsSelected}"
                                                   Tapped="CategoryChip_OnTapped"/>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Income: what happens with it -->
                <Border Style="{StaticResource Card}"
                        Padding="16,14"
                        IsVisible="{Binding IsIncome}">
                    <Label Style="{StaticResource TextBodySoft}"
                           Text="{Binding IncomeHint}"/>
                </Border>

                <!-- Note -->
                <Border Style="{StaticResource FieldTile}">
                    <Grid ColumnDefinitions="auto,*"
                          ColumnSpacing="8">
                        <controls:IconView Grid.Column="0"
                                           Data="{x:Static controls:Icons.Pencil}"
                                           Size="18"
                                           VerticalOptions="Center"
                                           Color="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}"/>
                        <controls:BorderlessEntry Grid.Column="1"
                               BackgroundColor="Transparent"
                               MinimumHeightRequest="44"
                               VerticalOptions="Center"
                               FontSize="15"
                               Placeholder="{x:Static resx:AppResources.NewTransaction_Note}"
                               Text="{Binding Description, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- Date and time -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="8">
                    <Border Grid.Column="0"
                            Style="{StaticResource FieldTile}">
                        <Grid>
                            <HorizontalStackLayout Spacing="8"
                                                   HorizontalOptions="Center"
                                                   InputTransparent="True">
                                <controls:IconView Data="{x:Static controls:Icons.Calendar}"
                                                   Size="18"
                                                   VerticalOptions="Center"
                                                   Color="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}"/>
                                <Label Style="{StaticResource TextBodyStrong}"
                                       VerticalTextAlignment="Center"
                                       Text="{Binding DateText}"/>
                            </HorizontalStackLayout>
                            <!-- Invisible native picker over the tile opens the system date picker -->
                            <DatePicker Opacity="0.02"
                                        TextColor="Transparent"
                                        BackgroundColor="Transparent"
                                        Date="{Binding Timestamp, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1"
                            Style="{StaticResource FieldTile}">
                        <Grid>
                            <HorizontalStackLayout Spacing="8"
                                                   HorizontalOptions="Center"
                                                   InputTransparent="True">
                                <controls:IconView Data="{x:Static controls:Icons.Clock}"
                                                   Size="18"
                                                   VerticalOptions="Center"
                                                   Color="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}"/>
                                <Label Style="{StaticResource TextBodyStrong}"
                                       VerticalTextAlignment="Center"
                                       Text="{Binding TimeText}"/>
                            </HorizontalStackLayout>
                            <!-- Invisible native picker over the tile opens the system time picker -->
                            <TimePicker Opacity="0.02"
                                        TextColor="Transparent"
                                        BackgroundColor="Transparent"
                                        Time="{Binding Time, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Recurring interval -->
                <Border Style="{StaticResource FieldTile}">
                    <Grid>
                        <Grid ColumnDefinitions="auto,*,auto"
                              ColumnSpacing="8"
                              InputTransparent="True"
                              CascadeInputTransparent="True">
                            <controls:IconView Grid.Column="0"
                                               Data="{x:Static controls:Icons.Repeat}"
                                               Size="18"
                                               VerticalOptions="Center"
                                               Color="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}"/>
                            <Label Grid.Column="1"
                                   Style="{StaticResource TextBody}"
                                   VerticalTextAlignment="Center"
                                   Text="{Binding IntervalText}"/>
                            <controls:IconView Grid.Column="2"
                                               Data="{x:Static controls:Icons.ChevronDown}"
                                               Size="16"
                                               VerticalOptions="Center"
                                               Color="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}"/>
                        </Grid>
                        <Picker x:Name="IntervalPicker"
                                Opacity="0.02"
                                TextColor="Transparent"
                                BackgroundColor="Transparent"
                                Title="{x:Static resx:AppResources.NewTransaction_Repeat}"
                                SelectedItem="{Binding SelectedInterval}"
                                ItemDisplayBinding="{Binding Name}"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Keypad and save -->
        <VerticalStackLayout Grid.Row="2"
                             Padding="16,12,16,16"
                             Spacing="12">
            <Grid ColumnDefinitions="*,*,*"
                  RowDefinitions="48,48,48,48"
                  ColumnSpacing="8"
                  RowSpacing="8">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Key}" ClassId="1"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Key_OnTapped"/></Border.GestureRecognizers><Label Style="{StaticResource KeyText}" Text="1"/></Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Key}" ClassId="2"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Key_OnTapped"/></Border.GestureRecognizers><Label Style="{StaticResource KeyText}" Text="2"/></Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Key}" ClassId="3"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Key_OnTapped"/></Border.GestureRecognizers><Label Style="{StaticResource KeyText}" Text="3"/></Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Key}" ClassId="4"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Key_OnTapped"/></Border.GestureRecognizers><Label Style="{StaticResource KeyText}" Text="4"/></Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Key}" ClassId="5"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Key_OnTapped"/></Border.GestureRecognizers><Label Style="{StaticResource KeyText}" Text="5"/></Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Key}" ClassId="6"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Key_OnTapped"/></Border.GestureRecognizers><Label Style="{StaticResource KeyText}" Text="6"/></Border>
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Key}" ClassId="7"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Key_OnTapped"/></Border.GestureRecognizers><Label Style="{StaticResource KeyText}" Text="7"/></Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Key}" ClassId="8"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Key_OnTapped"/></Border.GestureRecognizers><Label Style="{StaticResource KeyText}" Text="8"/></Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Key}" ClassId="9"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Key_OnTapped"/></Border.GestureRecognizers><Label Style="{StaticResource KeyText}" Text="9"/></Border>
                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource FlatKey}" ClassId="."
                        SemanticProperties.Description="{x:Static resx:AppResources.NewTransaction_DecimalPoint}">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="Key_OnTapped"/></Border.GestureRecognizers>
                    <Label Style="{StaticResource KeyText}" Text="."/>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource Key}" ClassId="0"><Border.GestureRecognizers><TapGestureRecognizer Tapped="Key_OnTapped"/></Border.GestureRecognizers><Label Style="{StaticResource KeyText}" Text="0"/></Border>
                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource FlatKey}" ClassId="back"
                        SemanticProperties.Description="{x:Static resx:AppResources.NewTransaction_Delete}">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="Key_OnTapped"/></Border.GestureRecognizers>
                    <controls:IconView Data="{x:Static controls:Icons.Backspace}"
                                       Size="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Color="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"/>
                </Border>
            </Grid>

            <Button Style="{StaticResource AccentButton}"
                    Text="{Binding SaveText}"
                    Clicked="EditTransactionButton_OnClicked"/>
        </VerticalStackLayout>
    </Grid>
</abstractions:BaseContentPage>
