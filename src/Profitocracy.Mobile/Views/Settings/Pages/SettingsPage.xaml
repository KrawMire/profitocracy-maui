<?xml version="1.0" encoding="utf-8"?>

<abstractions:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                              xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
                              xmlns:resx="clr-namespace:Profitocracy.Mobile.Resources.Strings"
                              xmlns:abstractions="clr-namespace:Profitocracy.Mobile.Abstractions"
                              xmlns:viewmodel="clr-namespace:Profitocracy.Mobile.ViewModels.Settings"
                              xmlns:profiles="clr-namespace:Profitocracy.Mobile.Models.Profiles"
                              xmlns:controls="clr-namespace:Profitocracy.Mobile.Views.Settings.Controls"
                              xmlns:sharedcontrols="clr-namespace:Profitocracy.Mobile.Views.Shared.Controls"
                              x:Class="Profitocracy.Mobile.Views.Settings.Pages.SettingsPage"
                              x:DataType="viewmodel:SettingsPageViewModel"
                              Title="{x:Static resx:AppResources.Pages_Settings}"
                              Shell.NavBarIsVisible="False"
                              ios:Page.UseSafeArea="True"
                              NavigatedTo="SettingsPage_OnNavigatedTo"
                              HideSoftInputOnTapped="True">
    <abstractions:BaseContentPage.Resources>
        <!-- Currency tile of a profile -->
        <Style TargetType="Label" x:Key="CurrencyTileText">
            <Setter Property="FontFamily" Value="SansBold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="VerticalTextAlignment" Value="Center"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"/>
        </Style>
    </abstractions:BaseContentPage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="16,0,16,32">

            <Label Style="{StaticResource TextTitleL}"
                   MinimumHeightRequest="44"
                   VerticalTextAlignment="Center"
                   Text="{x:Static resx:AppResources.Pages_Settings}"/>
            <Label Style="{StaticResource TextBodySoft}"
                   Margin="0,8,0,0"
                   Text="{x:Static resx:AppResources.Settings_Subtitle}"/>

            <!-- Profiles -->
            <Grid ColumnDefinitions="*,auto"
                  Margin="4,24,4,0">
                <Label Grid.Column="0"
                       Style="{StaticResource TextTitleM}"
                       VerticalTextAlignment="Center"
                       Text="{x:Static resx:AppResources.Settings_Profiles}"/>
                <Label Grid.Column="1"
                       Style="{StaticResource LinkLabel}"
                       Padding="8,0"
                       Margin="0,0,-8,0"
                       Text="{x:Static resx:AppResources.Settings_NewProfile}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="AddProfileButton_OnTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- The note: profile in use -->
            <Border Style="{StaticResource NoteCard}"
                    Margin="0,4,0,0"
                    Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CurrentProfile_OnTapped"/>
                </Border.GestureRecognizers>
                <Grid>
                    <sharedcontrols:NotePatternView RosetteRings="5"/>
                    <VerticalStackLayout Padding="20,16"
                                         Spacing="12">
                        <Grid ColumnDefinitions="auto,*,auto"
                              ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    Style="{StaticResource IconTile}"
                                    BackgroundColor="{StaticResource Chartreuse}">
                                <Label Style="{StaticResource CurrencyTileText}"
                                       TextColor="{StaticResource Ink}"
                                       Text="{Binding CurrentProfile.CurrencyBadge, FallbackValue=''}"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Style="{StaticResource TextBodyStrong}"
                                       TextColor="{StaticResource OnNote}"
                                       LineBreakMode="TailTruncation"
                                       Text="{Binding CurrentProfile.Name, FallbackValue=''}"/>
                                <Label Style="{StaticResource NoteCaptionSmall}"
                                       LineBreakMode="TailTruncation"
                                       Text="{Binding CurrentProfile.Detail, FallbackValue=''}"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2"
                                    Padding="10,2"
                                    VerticalOptions="Center"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource Chartreuse}">
                                <Label Style="{StaticResource TextCaption}"
                                       FontFamily="SansSemiBold"
                                       TextColor="{StaticResource Ink}"
                                       Text="{x:Static resx:AppResources.Settings_InUse}"/>
                            </Border>
                        </Grid>
                        <Label Style="{StaticResource NoteSerialText}"
                               Text="{Binding CurrentProfileSerial}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Other profiles -->
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0"
                    IsVisible="{Binding HasOtherProfiles}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding OtherProfiles}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="profiles:ProfileModel">
                            <VerticalStackLayout>
                                <sharedcontrols:ListDivider/>
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItemView Invoked="EditProfile_OnInvoked">
                                                <Grid WidthRequest="64"
                                                      BackgroundColor="{StaticResource InfoBlue}">
                                                    <sharedcontrols:IconView Data="{x:Static sharedcontrols:Icons.Pencil}"
                                                                             HorizontalOptions="Center"
                                                                             VerticalOptions="Center"
                                                                             Color="{StaticResource White}"/>
                                                </Grid>
                                            </SwipeItemView>
                                            <SwipeItemView Invoked="DeleteProfile_OnInvoked">
                                                <Grid WidthRequest="64"
                                                      BackgroundColor="{StaticResource OverLimit}">
                                                    <sharedcontrols:IconView Data="{x:Static sharedcontrols:Icons.Trash}"
                                                                             HorizontalOptions="Center"
                                                                             VerticalOptions="Center"
                                                                             Color="{StaticResource White}"/>
                                                </Grid>
                                            </SwipeItemView>
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Grid ColumnDefinitions="auto,*,auto"
                                          ColumnSpacing="12"
                                          Padding="16,14,8,14"
                                          BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}">
                                        <Border Grid.Column="0"
                                                Style="{StaticResource IconTile}">
                                            <Label Text="{Binding CurrencyBadge}">
                                                <Label.Style>
                                                    <Style TargetType="Label" BasedOn="{StaticResource CurrencyTileText}">
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding IsCodeBadge}"
                                                                         Value="True">
                                                                <Setter Property="FontFamily" Value="PlexMonoMedium"/>
                                                                <Setter Property="FontSize" Value="11"/>
                                                                <Setter Property="CharacterSpacing" Value="0.88"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Label.Style>
                                            </Label>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="4"
                                                             VerticalOptions="Center">
                                            <Label Style="{StaticResource TextBodyStrong}"
                                                   LineBreakMode="TailTruncation"
                                                   Text="{Binding Name}"/>
                                            <Label Style="{StaticResource TextCaption}"
                                                   LineBreakMode="TailTruncation"
                                                   Text="{Binding Detail}"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Style="{StaticResource LinkLabel}"
                                               Padding="8,0"
                                               Text="{x:Static resx:AppResources.Settings_Switch}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="SwitchProfile_OnTapped"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </SwipeView>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <!-- Budget -->
            <Label Style="{StaticResource TextTitleM}"
                   Margin="4,24,4,0"
                   Text="{x:Static resx:AppResources.Settings_Budget}"/>
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0">
                <VerticalStackLayout>
                    <controls:NavigationButton Title="{x:Static resx:AppResources.Settings_CategoriesLimits}"
                                               Value="{Binding CategoriesSummary}"
                                               Clicked="CategoriesButton_OnClicked"/>
                    <BoxView Style="{StaticResource Divider}"/>
                    <controls:NavigationButton Title="{x:Static resx:AppResources.Settings_BudgetSplit}"
                                               Clicked="BudgetSplitButton_OnClicked">
                        <controls:NavigationButton.Accessory>
                            <!-- Rubber stamp with the split -->
                            <Border Padding="7,3"
                                    Rotation="-3"
                                    StrokeThickness="1.5"
                                    StrokeDashArray="3,2"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"
                                    BackgroundColor="Transparent">
                                <Label Style="{StaticResource TextSerial}"
                                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"
                                       Text="50 · 30 · 20"/>
                            </Border>
                        </controls:NavigationButton.Accessory>
                    </controls:NavigationButton>
                    <BoxView Style="{StaticResource Divider}"/>
                    <controls:NavigationButton Title="{x:Static resx:AppResources.Settings_Appearance}"
                                               Value="{Binding Appearance}"
                                               Clicked="ThemeButton_OnClicked"/>
                </VerticalStackLayout>
            </Border>

            <!-- Application -->
            <Label Style="{StaticResource TextTitleM}"
                   Margin="4,24,4,0"
                   Text="{x:Static resx:AppResources.Settings_Application}"/>
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0">
                <VerticalStackLayout>
                    <controls:NavigationButton Title="{x:Static resx:AppResources.Settings_Authentication}"
                                               Clicked="AuthenticationButton_OnClicked"/>
                    <BoxView Style="{StaticResource Divider}"/>
                    <controls:NavigationButton Title="{x:Static resx:AppResources.Settings_Notifications}"
                                               Clicked="NotificationsButton_OnClicked"/>
                    <BoxView Style="{StaticResource Divider}"/>
                    <controls:NavigationButton Title="{x:Static resx:AppResources.Settings_Language}"
                                               Clicked="LanguageButton_OnClicked"/>
                    <BoxView Style="{StaticResource Divider}"/>
                    <controls:NavigationButton Title="{x:Static resx:AppResources.Settings_ImportExport}"
                                               Clicked="ImportExportButton_OnClicked"/>
                </VerticalStackLayout>
            </Border>

            <!-- About -->
            <Label Style="{StaticResource TextTitleM}"
                   Margin="4,24,4,0"
                   Text="{x:Static resx:AppResources.Settings_AboutApplication}"/>
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0">
                <VerticalStackLayout>
                    <controls:NavigationButton Title="{x:Static resx:AppResources.Settings_GitHub}"
                                               Clicked="GitHubButton_OnClicked"/>
                    <BoxView Style="{StaticResource Divider}"/>
                    <controls:NavigationButton Title="{x:Static resx:AppResources.Settings_RateTheApp}"
                                               Clicked="RateAppButton_OnClicked"/>
                    <BoxView Style="{StaticResource Divider}"/>
                    <Grid ColumnDefinitions="*,auto"
                          Padding="16,14"
                          MinimumHeightRequest="48">
                        <Label Grid.Column="0"
                               Style="{StaticResource TextBodyStrong}"
                               VerticalTextAlignment="Center"
                               Text="{x:Static resx:AppResources.Settings_Version}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource TextSerial}"
                               VerticalTextAlignment="Center"
                               x:Name="VersionLabel"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource TextLabelSoft}"
                   Margin="4,16,4,0"
                   Text="{x:Static resx:AppResources.Settings_Footer}"/>
        </VerticalStackLayout>
    </ScrollView>
</abstractions:BaseContentPage>
