<?xml version="1.0" encoding="utf-8"?>

<abstractions:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                              xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
                              xmlns:resx="clr-namespace:Profitocracy.Mobile.Resources.Strings"
                              xmlns:abstractions="clr-namespace:Profitocracy.Mobile.Abstractions"
                              xmlns:viewmodel="clr-namespace:Profitocracy.Mobile.ViewModels.Overview"
                              xmlns:categories="clr-namespace:Profitocracy.Mobile.Models.Categories"
                              xmlns:controls="clr-namespace:Profitocracy.Mobile.Views.Shared.Controls"
                              xmlns:overviewcontrols="clr-namespace:Profitocracy.Mobile.Views.Overview.Controls"
                              x:Class="Profitocracy.Mobile.Views.Overview.Pages.OverviewPage"
                              x:DataType="viewmodel:OverviewPageViewModel"
                              Title="{x:Static resx:AppResources.Pages_Insights}"
                              Shell.NavBarIsVisible="False"
                              ios:Page.UseSafeArea="True"
                              NavigatedTo="OverviewPage_OnNavigatedTo"
                              HideSoftInputOnTapped="True">
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="16,0,16,32">

            <!-- Title and the covered days -->
            <Grid ColumnDefinitions="*,auto"
                  MinimumHeightRequest="44">
                <Label Grid.Column="0"
                       Style="{StaticResource TextTitleL}"
                       VerticalTextAlignment="Center"
                       Text="{x:Static resx:AppResources.Pages_Insights}"/>
                <Label Grid.Column="1"
                       Style="{StaticResource TextSerial}"
                       VerticalTextAlignment="Center"
                       Text="{Binding DateRange}"/>
            </Grid>

            <!-- Period -->
            <Border Style="{StaticResource Card}"
                    Margin="0,16,0,0"
                    Padding="4">
                <Grid ColumnDefinitions="*,*,*,*"
                      ColumnSpacing="4">
                    <controls:ChipView Grid.Column="0"
                                       Text="{x:Static resx:AppResources.Insights_Week}"
                                       IsSelected="{Binding IsWeek}"
                                       Tapped="WeekChip_OnTapped"/>
                    <controls:ChipView Grid.Column="1"
                                       Text="{x:Static resx:AppResources.Insights_Month}"
                                       IsSelected="{Binding IsMonth}"
                                       Tapped="MonthChip_OnTapped"/>
                    <controls:ChipView Grid.Column="2"
                                       Text="{x:Static resx:AppResources.Insights_Year}"
                                       IsSelected="{Binding IsYear}"
                                       Tapped="YearChip_OnTapped"/>
                    <controls:ChipView Grid.Column="3"
                                       Text="{x:Static resx:AppResources.Insights_Custom}"
                                       IsSelected="{Binding IsCustom}"
                                       Tapped="CustomChip_OnTapped"/>
                </Grid>
            </Border>

            <!-- The note: how much of the income is kept -->
            <Border Style="{StaticResource NoteCard}"
                    Margin="0,12,0,0"
                    Padding="0">
                <Grid>
                    <controls:NotePatternView/>
                    <VerticalStackLayout Padding="20">
                        <Label Style="{StaticResource NoteLabel}"
                               Text="{x:Static resx:AppResources.Insights_KeptSoFar}"/>
                        <Label Style="{StaticResource NoteHeroAmount}"
                               Margin="0,8,0,0"
                               Text="{Binding KeptPercent}"/>
                        <Label Style="{StaticResource TextBody}"
                               TextColor="{StaticResource OnNote}"
                               Margin="0,4,0,0"
                               Text="{Binding KeptText}"/>

                        <BoxView Style="{StaticResource NoteDivider}"
                                 Margin="0,16,0,0"/>

                        <VerticalStackLayout Margin="0,16,0,0"
                                             Spacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,auto">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource NoteLabel}"
                                           Text="{x:Static resx:AppResources.Insights_Income}"/>
                                    <Label Grid.Column="1"
                                           Style="{StaticResource TextLabel}"
                                           TextColor="{StaticResource OnNote}"
                                           Text="{Binding Income}"/>
                                </Grid>
                                <controls:MeterView BarHeight="6"
                                                    Progress="{Binding IncomeRatio}"
                                                    TrackColor="{AppThemeBinding Light={StaticResource NoteTrack}, Dark={StaticResource DarkNoteTrack}}"
                                                    FillColor="{StaticResource Chartreuse}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,auto">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource NoteLabel}"
                                           Text="{x:Static resx:AppResources.Insights_Spent}"/>
                                    <Label Grid.Column="1"
                                           Style="{StaticResource TextLabel}"
                                           TextColor="{StaticResource OnNote}"
                                           Text="{Binding Spent}"/>
                                </Grid>
                                <controls:MeterView BarHeight="6"
                                                    Progress="{Binding SpentRatio}"
                                                    TrackColor="{AppThemeBinding Light={StaticResource NoteTrack}, Dark={StaticResource DarkNoteTrack}}"
                                                    FillColor="{StaticResource OnNote}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,auto">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource NoteLabel}"
                                           Text="{x:Static resx:AppResources.Insights_PutAside}"/>
                                    <Label Grid.Column="1"
                                           Style="{StaticResource TextLabel}"
                                           TextColor="{StaticResource OnNote}"
                                           Text="{Binding PutAside}"/>
                                </Grid>
                                <controls:MeterView BarHeight="6"
                                                    Progress="{Binding PutAsideRatio}"
                                                    TrackColor="{AppThemeBinding Light={StaticResource NoteTrack}, Dark={StaticResource DarkNoteTrack}}"
                                                    FillColor="{StaticResource SageText}"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Where it went -->
            <Grid ColumnDefinitions="*,auto"
                  Margin="4,24,4,0">
                <Label Grid.Column="0"
                       Style="{StaticResource TextTitleM}"
                       VerticalTextAlignment="End"
                       Text="{x:Static resx:AppResources.Insights_WhereItWent}"/>
                <Label Grid.Column="1"
                       Style="{StaticResource TextLabelSoft}"
                       VerticalTextAlignment="End"
                       Text="{Binding UsedTotal}"/>
            </Grid>
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0"
                    Padding="16">
                <Grid ColumnDefinitions="auto,*"
                      ColumnSpacing="16">
                    <overviewcontrols:ChamberChartView Grid.Column="0"
                                                       VerticalOptions="Center"
                                                       MainUsed="{Binding MainSeats}"
                                                       SecondaryUsed="{Binding SecondarySeats}"
                                                       SavedUsed="{Binding SavedSeats}"
                                                       MainColor="{AppThemeBinding Light={StaticResource MainColor}, Dark={StaticResource DarkMainColor}}"
                                                       MainTint="{AppThemeBinding Light={StaticResource MainTint}, Dark={StaticResource DarkMainTint}}"
                                                       SecondaryColor="{StaticResource SecondaryColor}"
                                                       SecondaryTint="{AppThemeBinding Light={StaticResource SecondaryTint}, Dark={StaticResource DarkSecondaryTint}}"
                                                       SavedColor="{StaticResource SavedColor}"
                                                       SavedTint="{AppThemeBinding Light={StaticResource SavedTint}, Dark={StaticResource DarkSavedTint}}"/>
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="12"
                                         VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse Style="{StaticResource SpendingDot}"
                                         Fill="{AppThemeBinding Light={StaticResource MainColor}, Dark={StaticResource DarkMainColor}}"/>
                                <Label Style="{StaticResource TextBodyStrong}"
                                       Text="{x:Static resx:AppResources.Home_Main}"/>
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource TextCaption}"
                                   Margin="14,0,0,0"
                                   Text="{Binding MainLegend}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse Style="{StaticResource SpendingDot}"
                                         Fill="{StaticResource SecondaryColor}"/>
                                <Label Style="{StaticResource TextBodyStrong}"
                                       Text="{x:Static resx:AppResources.Home_Secondary}"/>
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource TextCaption}"
                                   Margin="14,0,0,0"
                                   Text="{Binding SecondaryLegend}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse Style="{StaticResource SpendingDot}"
                                         Fill="{StaticResource SavedColor}"/>
                                <Label Style="{StaticResource TextBodyStrong}"
                                       Text="{x:Static resx:AppResources.Home_Saved}"/>
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource TextCaption}"
                                   Margin="14,0,0,0"
                                   Text="{Binding SavedLegend}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Day by day -->
            <Grid ColumnDefinitions="*,auto"
                  Margin="4,24,4,0">
                <Label Grid.Column="0"
                       Style="{StaticResource TextTitleM}"
                       VerticalTextAlignment="End"
                       Text="{Binding BarsTitle}"/>
                <Label Grid.Column="1"
                       Style="{StaticResource TextLabelSoft}"
                       VerticalTextAlignment="End"
                       Text="{x:Static resx:AppResources.Insights_SavingsNotCounted}"/>
            </Grid>
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0"
                    Padding="16">
                <overviewcontrols:SpendingBarsView Bars="{Binding Bars}"
                                                   Average="{Binding BarsAverage}"
                                                   AverageText="{Binding BarsAverageText}"
                                                   NoteText="{Binding BarsNote}"
                                                   BarColor="{AppThemeBinding Light={StaticResource MainColor}, Dark={StaticResource DarkMainColor}}"
                                                   OverColor="{StaticResource OverLimit}"
                                                   NoteColor="{AppThemeBinding Light={StaticResource OverText}, Dark={StaticResource DarkOverText}}"
                                                   EmptyColor="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}"
                                                   TextColor="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}"
                                                   SurfaceColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"/>
            </Border>

            <!-- Against your limits -->
            <Grid ColumnDefinitions="*,auto"
                  Margin="4,24,4,0">
                <Label Grid.Column="0"
                       Style="{StaticResource TextTitleM}"
                       VerticalTextAlignment="End"
                       Text="{x:Static resx:AppResources.Insights_AgainstLimits}"/>
                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="6"
                                       VerticalOptions="End">
                    <BoxView WidthRequest="2"
                             HeightRequest="12"
                             VerticalOptions="Center"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"/>
                    <Label Style="{StaticResource TextLabelSoft}"
                           Text="{x:Static resx:AppResources.Insights_Limit}"/>
                </HorizontalStackLayout>
            </Grid>
            <Border Style="{StaticResource Card}"
                    Margin="0,12,0,0"
                    IsVisible="{Binding HasLimits}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Limits}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="categories:CategoryLimitModel">
                            <VerticalStackLayout>
                                <controls:ListDivider/>
                                <VerticalStackLayout Padding="16,14"
                                                     Spacing="8">
                                    <Grid ColumnDefinitions="*,auto"
                                          ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Style="{StaticResource TextBodyStrong}"
                                               LineBreakMode="TailTruncation"
                                               VerticalTextAlignment="End"
                                               Text="{Binding Name}"/>
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="4">
                                            <Label Style="{StaticResource TextAmountM}"
                                                   VerticalTextAlignment="End"
                                                   Text="{Binding Actual}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsOver}"
                                                                 Value="True">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OverText}, Dark={StaticResource DarkOverText}}"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Style="{StaticResource TextCaption}"
                                                   VerticalTextAlignment="End"
                                                   Margin="0,0,0,1"
                                                   Text="{Binding Limit}"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <controls:MeterView Progress="{Binding Progress}"
                                                        Mark="{Binding Mark}"
                                                        FillColor="{AppThemeBinding Light={StaticResource MainColor}, Dark={StaticResource DarkMainColor}}"
                                                        TrackColor="{AppThemeBinding Light={StaticResource MainTint}, Dark={StaticResource DarkMainTint}}"
                                                        MarkColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}">
                                        <controls:MeterView.Triggers>
                                            <DataTrigger TargetType="controls:MeterView"
                                                         Binding="{Binding IsOver}"
                                                         Value="True">
                                                <Setter Property="FillColor" Value="{StaticResource OverLimit}"/>
                                                <Setter Property="TrackColor" Value="{AppThemeBinding Light={StaticResource OverTint}, Dark={StaticResource DarkOverTint}}"/>
                                            </DataTrigger>
                                        </controls:MeterView.Triggers>
                                    </controls:MeterView>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
            <Label Style="{StaticResource TextBodySoft}"
                   Margin="4,12,4,0"
                   IsVisible="{Binding HasNoLimits}"
                   Text="{x:Static resx:AppResources.Insights_NoCategories}"/>
        </VerticalStackLayout>
    </ScrollView>
</abstractions:BaseContentPage>
